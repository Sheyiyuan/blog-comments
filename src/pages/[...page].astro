---
import { PAGE_SIZE } from "@constants/constants";
import { getSortedPosts } from "@utils/content-utils";
import { toAbsoluteUrl } from "@utils/plain-text";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	// Page 1 is the real homepage in index.astro. Later pages are legacy URLs.
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE }).filter(
		(entry) => Number(entry.props?.page?.currentPage ?? 1) > 1,
	);
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const currentPage = Number(page?.currentPage ?? 1);
const targetPath = currentPage <= 1 ? "/passage/" : `/passage/${currentPage}/`;
const targetUrl = toAbsoluteUrl(Astro.site, targetPath);
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex, nofollow" />
		<meta http-equiv="refresh" content={`0; url=${targetUrl}`} />
		<link rel="canonical" href={targetUrl} />
		<title>页面已移动</title>
	</head>
	<body>
		<p>
			页面已移动到 <a href={targetUrl}>{targetUrl}</a>
		</p>
	</body>
</html>