---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import EssayCard from "@components/EssayCard.astro";
import { getSortedEssays } from "@utils/content-utils";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

const essays = await getSortedEssays();

type GalleryImage = { src: string; alt?: string };
type EssayEntry = (typeof essays)[number];
type EssayWithGallery = { entry: EssayEntry; galleryImages: GalleryImage[] };

const essaysWithGallery: EssayWithGallery[] = await Promise.all(
	essays.map(async (entry) => {
		const { remarkPluginFrontmatter } = await entry.render();
		const galleryImages = (Array.isArray(remarkPluginFrontmatter?.galleryImages)
			? remarkPluginFrontmatter.galleryImages
			: []) as GalleryImage[];
		return { entry, galleryImages };
	}),
);

let delay = 0;
const interval = 50;
---

<MainGridLayout title={i18n(I18nKey.essays)} description={i18n(I18nKey.essaysDescription)}>
	<div class="transition flex flex-col rounded-[var(--radius-large)] overflow-visible py-1 md:py-0 md:gap-4 mb-4">
		{essaysWithGallery.length === 0 ? (
			<div class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 text-75">
				{i18n(I18nKey.noEssays)}
			</div>
		) : (
			essaysWithGallery.map((item: EssayWithGallery) => (
				<EssayCard
					entry={item.entry}
					galleryImages={item.galleryImages}
					class:list="onload-animation"
					style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
				/>
			))
		)}
	</div>
</MainGridLayout>
