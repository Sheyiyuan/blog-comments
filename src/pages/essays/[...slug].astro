---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import Markdown from "@components/misc/Markdown.astro";
import Giscus from "@components/misc/Giscus.astro";
import I18nKey from "@i18n/i18nKey";
import { getTranslation } from "@i18n/translation";
import { giscusConfig } from "@/config";
import { siteConfig, profileConfig } from "@/config";
import { getSortedEssays } from "@utils/content-utils";
import { getEssayExcerptFromBody, getEssayDisplayTitle, getEssayRouteSlug } from "@utils/essay-utils";
import { formatDateTimeToISOWithOffset, formatDateTimeToYYYYMMDDHHmm } from "@utils/date-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const entries = await getSortedEssays();
	return entries.map((entry) => ({
		params: { slug: getEssayRouteSlug(entry) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const manualTitle = (entry.data.title ?? "").trim();
const title = getEssayDisplayTitle(entry);
const excerpt = getEssayExcerptFromBody(entry.body);

const footnoteForI18n = getTranslation(entry.data.lang || siteConfig.lang)[I18nKey.footnotes];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description: excerpt || title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateTimeToISOWithOffset(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const tr = getTranslation(entry.data.lang || siteConfig.lang);
const commentsGloballyEnabled = giscusConfig.enable;
const commentsClosedForEntry = entry.data.comments === false;
---

<MainGridLayout title={title} description={excerpt} headings={headings} setOGTypeArticle={true}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<div id="essay-container" class="card-base onload-animation z-10 px-6 md:px-9 pt-6 pb-4 relative w-full" style="animation-delay: var(--content-delay);">
			<div class="relative onload-animation">
				<!-- Keep Pagefind meta title for search even if UI title is hidden -->
				<span data-pagefind-meta="title" class="sr-only">{title}</span>
				{manualTitle && (
					<div
						data-pagefind-body
						data-pagefind-weight="10"
						class="transition w-full block font-bold mb-3
							text-3xl md:text-[2.25rem]/[2.75rem]
							text-black/90 dark:text-white/90
							md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
							before:absolute before:top-[0.75rem] before:left-[-1.125rem]
						"
					>
						{manualTitle}
					</div>
				)}
			</div>

			<div class="flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center gap-3 mb-5 onload-animation">
				<span class="text-50 text-sm font-medium">{formatDateTimeToYYYYMMDDHHmm(entry.data.published)}</span>
				{entry.data.tags?.length ? (
					<span class="text-50 text-sm font-medium">· {entry.data.tags.join(" / ")}</span>
				) : null}
			</div>

			<Markdown class="mb-6 markdown-content onload-animation">
				<Content />
			</Markdown>


			{commentsGloballyEnabled && (
				<div class="mb-6 rounded-xl card-base px-6 md:px-7 py-6 onload-animation">
					{commentsClosedForEntry ? (
						<div>
							<div class="flex items-center gap-2 mb-1 text-black/60 dark:text-white/60">
								<Icon name="material-symbols:comments-disabled-outline-rounded" class="text-[1.25rem]" />
								<div class="font-medium">{tr[I18nKey.comments]}</div>
							</div>
							<div class="text-sm text-black/50 dark:text-white/50">{tr[I18nKey.commentsClosed]}</div>
						</div>
					) : (
						<Giscus />
					)}
				</div>
			)}
		</div>
	</div>
    <!-- 脚本用于处理脚注的 i18n 和样式，不修改原 DOM 以便 SEO -->
    <script is:inline define:vars={{translatedFootnote: footnoteForI18n}}>
        const updateFootnotes = () => {
            const footnoteLabel = document.getElementById('footnote-label');
            if (footnoteLabel) {
                footnoteLabel.innerText = translatedFootnote;
                footnoteLabel.classList.remove('sr-only');
            }
            const backRefs = document.querySelectorAll('.data-footnote-backref');
            backRefs.forEach((backRef) => {
                // 使用 SVG 替换原来的返回按钮
                backRef.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>`;
                backRef.classList.add('footnote-backref-icon');
            });
        };

        const handleFootnoteBackClick = (e) => {
            const backRef = e.target.closest('.data-footnote-backref');
            if (backRef) {
                const href = backRef.getAttribute('href');
                if (!href || !href.startsWith('#')) return;

                const targetId = href.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();
                    // 阻止 Swup 或其他脚本处理此点击
                    e.stopPropagation();

                    const offset = 120; // 顶栏高度补偿
                    const elementPosition = targetElement.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.scrollY - offset;

                    window.scrollTo({
                            top: offsetPosition,
                            behavior: "smooth"
                    });

                    // 更改 URL hash
                    history.pushState(null, null, '#' + targetId);
                }
            }
        };

        // 使用事件委托，并在捕获阶段处理，确保优先执行
        document.addEventListener('click', handleFootnoteBackClick, true);

        updateFootnotes();

        // Re-init on Swup navigation
        if (window.swup) {
            window.swup.hooks.on('page:view', updateFootnotes);
        } else {
            document.addEventListener('swup:enable', () => {
                window.swup.hooks.on('page:view', updateFootnotes);
            });
        }
    </script>
</MainGridLayout>
