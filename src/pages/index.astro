---
import EssayCard from "@components/EssayCard.astro";
import PostCard from "@components/PostCard.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedEssays, getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import { homePageConfig } from "@/config";
import { HomeSectionPreset } from "@/types/config";
import { Icon } from "astro-icon/components";

type GalleryImage = { src: string; alt?: string };

const essaysCount = Math.max(
	0,
	Number(homePageConfig?.recentEssays?.count ?? 0),
);
const postsCount = Math.max(0, Number(homePageConfig?.recentPosts?.count ?? 0));

const sections =
	homePageConfig?.sections ??
	([HomeSectionPreset.Essays, HomeSectionPreset.Posts] as const);

const [allEssays, allPosts] = await Promise.all([
	getSortedEssays(),
	getSortedPosts(),
]);
const essays = allEssays.slice(0, essaysCount);
const posts = allPosts.slice(0, postsCount);

const essaysWithGallery = await Promise.all(
	essays.map(async (entry) => {
		const { remarkPluginFrontmatter } = await entry.render();
		const galleryImages = (
			Array.isArray(remarkPluginFrontmatter?.galleryImages)
				? remarkPluginFrontmatter.galleryImages
				: []
		) as GalleryImage[];
		return { entry, galleryImages };
	}),
);

let delay = 0;
const interval = 50;
---

<MainGridLayout sidebarContentType="all">
	    <div class="flex flex-col gap-4 mb-4">
	        <!-- 欢迎卡片 -->
	        <section class="card-base onload-animation rounded-[var(--radius-large)] px-6 md:px-9 py-6 mb-4" style="animation-delay: var(--content-delay);">
	            <h2 class="font-bold text-xl md:text-2xl text-90 mb-4">欢迎来到我的数字营地</h2>
	            <div class="space-y-3 text-75">
	                <p>这里存放着我在理性代码与感性随笔间的摇摆轨迹：</p>
	                <ul class="list-disc pl-5 space-y-1">
	                    <li><strong>技术避坑指南</strong> - 折腾记录、故障排查、实用配置</li>
	                    <li><strong>心理碎片档案馆</strong> - 小说、随笔、情感记录与虚构探索</li>
	                    <li><strong>"混乱善良"观察日志</strong> - 在秩序与混乱间寻找平衡的日常</li>
	                </ul>
	                <p class="pt-2">从骰娘到代码，从统计学到故事，这里是我的旅行笔记。希望这些记录对你有用，或至少让你感到不孤独。</p>
	                <div class="flex flex-wrap gap-2 mt-4">
	                    <a href="/about/" class="btn-regular rounded-lg h-9 px-4 text-sm">关于我</a>
	                    <a href="/passage/" class="btn-regular rounded-lg h-9 px-4 text-sm">精选文章</a>
	                    <a href="/essays/" class="btn-regular rounded-lg h-9 px-4 text-sm">生活随笔</a>
	                </div>
	            </div>
	        </section>

	        {sections.map((section) => {
			if (section === HomeSectionPreset.Essays) {
				return (
					<>
						<section class="flex items-center justify-between px-6 md:px-9 py-4 mt-6">
							<div class="flex items-center gap-3">
								<div class="w-1.5 h-6 bg-[var(--primary)] rounded-full"></div>
								<h2 class="font-bold text-2xl md:text-3xl text-90">
									{i18n(I18nKey.recentEssays)}
								</h2>
							</div>
							<a href={url("/essays/")} class="group flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:opacity-80 transition-opacity">
								查看全部
								<Icon name="material-symbols:chevron-right-rounded" class="text-xl group-hover:translate-x-1 transition-transform" />
							</a>
						</section>

						{essaysWithGallery.length === 0 ? (
							<div class="card-base onload-animation rounded-[var(--radius-large)] px-6 md:px-9 py-6 text-75" style="animation-delay: var(--content-delay);">
								{i18n(I18nKey.noEssays)}
							</div>
						) : (
							<div class="transition flex flex-col rounded-[var(--radius-large)] overflow-visible py-1 md:py-0 md:gap-4 mb-4">
								{essaysWithGallery.map((item) => (
									<EssayCard
										entry={item.entry}
										galleryImages={item.galleryImages}
										class:list="onload-animation"
										style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
									/>
								))}
							</div>

						)}
					</>
				);
			}

			if (section === HomeSectionPreset.Posts) {
				return (
					<>
						<section class="flex items-center justify-between px-6 md:px-9 py-4 mt-6">
							<div class="flex items-center gap-3">
								<div class="w-1.5 h-6 bg-[var(--primary)] rounded-full"></div>
								<h2 class="font-bold text-2xl md:text-3xl text-90">
									{i18n(I18nKey.recentPosts)}
								</h2>
							</div>
							<a href={url("/passage/")} class="group flex items-center gap-1 text-sm font-medium text-[var(--primary)] hover:opacity-80 transition-opacity">
								查看全部
								<Icon name="material-symbols:chevron-right-rounded" class="text-xl group-hover:translate-x-1 transition-transform" />
							</a>
						</section>

						{posts.length === 0 ? (
							<div class="card-base onload-animation rounded-[var(--radius-large)] px-6 md:px-9 py-6 text-75" style="animation-delay: var(--content-delay);">
								{i18n(I18nKey.noPosts)}
							</div>
						) : (
							<div class="transition flex flex-col rounded-[var(--radius-large)] overflow-visible py-1 md:py-0 md:gap-4 mb-4">
								{posts.map((entry) => (
									<PostCard
										entry={entry}
										title={entry.data.title}
										tags={entry.data.tags}
										category={entry.data.category}
										published={entry.data.published}
										updated={entry.data.updated}
										url={getPostUrlBySlug(entry.slug)}
										image={entry.data.image}
										description={entry.data.description}
										draft={entry.data.draft}
										class:list="onload-animation"
										style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
									></PostCard>
								))}
							</div>

						)}
					</>
				);
			}

			return null;
		})}
	</div>
</MainGridLayout>
