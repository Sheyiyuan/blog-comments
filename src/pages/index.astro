---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import EssayCard from "@components/EssayCard.astro";
import PostCard from "@components/PostCard.astro";

import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

import { homePageConfig } from "@/config";
import { HomeSectionPreset } from "@/types/config";
import { getSortedEssays, getSortedPosts } from "@utils/content-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";

type GalleryImage = { src: string; alt?: string };

const essaysCount = Math.max(0, Number(homePageConfig?.recentEssays?.count ?? 0));
const postsCount = Math.max(0, Number(homePageConfig?.recentPosts?.count ?? 0));

const sections =
	homePageConfig?.sections ??
	([HomeSectionPreset.Essays, HomeSectionPreset.Posts] as const);

const [allEssays, allPosts] = await Promise.all([getSortedEssays(), getSortedPosts()]);
const essays = allEssays.slice(0, essaysCount);
const posts = allPosts.slice(0, postsCount);

const essaysWithGallery = await Promise.all(
	essays.map(async (entry) => {
		const { remarkPluginFrontmatter } = await entry.render();
		const galleryImages = (Array.isArray(remarkPluginFrontmatter?.galleryImages)
			? remarkPluginFrontmatter.galleryImages
			: []) as GalleryImage[];
		return { entry, galleryImages };
	}),
);

let delay = 0;
const interval = 50;
---

<MainGridLayout>
	<div class="flex flex-col gap-4 mb-4">
		{sections.map((section) => {
			if (section === HomeSectionPreset.Essays) {
				return (
					<>
						<section class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6">
							<div class="flex items-center justify-between gap-4">
								<h2 class="font-bold text-xl md:text-2xl text-90">
									{i18n(I18nKey.recentEssays)}
								</h2>
								<a
									href={url("/essays/")}
									class="btn-regular rounded-lg h-10 px-4 font-bold active:scale-95"
								>
									{i18n(I18nKey.more)}
								</a>
							</div>
						</section>

						{essaysWithGallery.length === 0 ? (
							<div class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 text-75">
								{i18n(I18nKey.noEssays)}
							</div>
						) : (
							<div class="transition flex flex-col rounded-[var(--radius-large)] overflow-visible py-1 md:py-0 md:gap-4 mb-4">
								{essaysWithGallery.map((item) => (
									<EssayCard
										entry={item.entry}
										galleryImages={item.galleryImages}
										class:list="onload-animation"
										style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
									/>
								))}
							</div>
						)}
					</>
				);
			}

			if (section === HomeSectionPreset.Posts) {
				return (
					<>
						<section class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6">
							<div class="flex items-center justify-between gap-4">
								<h2 class="font-bold text-xl md:text-2xl text-90">
									{i18n(I18nKey.recentPosts)}
								</h2>
								<a
									href={url("/passage/")}
									class="btn-regular rounded-lg h-10 px-4 font-bold active:scale-95"
								>
									{i18n(I18nKey.more)}
								</a>
							</div>
						</section>

						{posts.length === 0 ? (
							<div class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-6 text-75">
								{i18n(I18nKey.noPosts)}
							</div>
						) : (
							<div class="transition flex flex-col rounded-[var(--radius-large)] overflow-visible py-1 md:py-0 md:gap-4 mb-4">
								{posts.map((entry) => (
									<PostCard
										entry={entry}
										title={entry.data.title}
										tags={entry.data.tags}
										category={entry.data.category}
										published={entry.data.published}
										updated={entry.data.updated}
										url={getPostUrlBySlug(entry.slug)}
										image={entry.data.image}
										description={entry.data.description}
										draft={entry.data.draft}
										class:list="onload-animation"
										style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
									></PostCard>
								))}
							</div>
						)}
					</>
				);
			}

			return null;
		})}
	</div>
</MainGridLayout>
