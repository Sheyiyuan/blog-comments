---
import { getCollection } from "astro:content";
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import SiteStats from "../components/widget/SiteStats.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	bannerBasePath?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	sidebarContentType?: "posts" | "notes" | "essays" | "all";
}

const {
	title,
	banner,
	bannerBasePath,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	sidebarContentType,
} = Astro.props;

const resolvedSidebarContentType =
	sidebarContentType ??
	(Astro.url.pathname.startsWith(url("/notes/"))
		? "notes"
		: Astro.url.pathname.startsWith(url("/essays/"))
			? "essays"
			: Astro.url.pathname.startsWith(url("/posts/")) ||
					Astro.url.pathname.startsWith(url("/passage/"))
				? "posts"
				: "all");
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
const isRightTocRoute =
	Astro.url.pathname.startsWith(url("/posts/")) ||
	Astro.url.pathname.startsWith(url("/notes/"));
const hasRightToc =
	siteConfig.toc.enable && isRightTocRoute && headings.length > 0;

const [postsCount, notesCount, essaysCount] = await Promise.all([
	getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	).then((items) => items.length),
	getCollection("notes", ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	).then((items) => items.length),
	getCollection("essays", ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	).then((items) => items.length),
]);

const startDateValue = siteConfig.siteStartDate ?? "2025-01-01";
const startDate = new Date(startDateValue);
const now = new Date();
const diffMs =
	Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) -
	Date.UTC(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
const runtimeDays = Math.max(1, Math.floor(diffMs / 86400000) + 1);

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none fixed top-0 left-0 right-0 transition-all duration-700 w-full" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto transition-all">
        <Navbar banner={banner} bannerBasePath={bannerBasePath}></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div id="main-panel-wrapper" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-1 lg:grid-cols-[16rem_minmax(0,1fr)_16rem]
    mx-auto gap-4 px-1 md:px-2"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar
                class:list={[
                    "mb-4 lg:mb-0",
                    { "order-2 lg:order-none": !isHomePage },
                ]}
                headings={headings}
                contentType={resolvedSidebarContentType}
            ></SideBar>

            <main id="swup-container" class:list={["transition-swup-fade overflow-hidden min-w-0", { "order-1 lg:order-none": !isHomePage }]}>
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <aside id="right-sidebar" class="hidden lg:block">
                <div id="right-sidebar-content" class="sticky top-[5.5rem]">
                    {hasRightToc ? (
                        <div id="toc-wrapper">
                            <div id="toc-inner-wrapper" class="h-[calc(100vh_-_12rem)] overflow-y-auto overflow-x-hidden hide-scrollbar">
                                <div id="toc" class="w-full h-full">
                                    <div class="h-8 w-full"></div>
                                    <TOC headings={headings}></TOC>
                                    <div class="h-8 w-full"></div>
                                </div>
                            </div>
                        </div>
                    ) : null}
                    <div class:list={[{"mt-4": hasRightToc}]}>
                        <SiteStats runtimeDays={runtimeDays} postsCount={postsCount} notesCount={notesCount} essaysCount={essaysCount}></SiteStats>
                    </div>
                </div>
            </aside>

            <div class:list={["footer onload-animation block lg:hidden", { "order-3": !isHomePage }]}>
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>
</Layout>
