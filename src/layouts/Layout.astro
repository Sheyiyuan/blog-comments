	justify-content: center;
	align-items: center;
	column-gap: 0.5rem;
	row-gap: 0.25rem;
	max-width: 100%;
}

.custom-md p.badge-row > img {
	flex: 0 0 auto;
	margin: 0 !important;
	display: block;
}
</style>

