const bannerEnabled = !!document.getElementById('banner-wrapper')
const SIDEBAR_OUT_ANIMATION_DURATION = 200;
const SIDEBAR_IN_ANIMATION_DURATION = 220;
let sidebarOutAnimations: Animation[] = [];
let pendingSidebarInSelectors: string[] = [];
let hasSidebarNavigationTransition = false;
let activeSidebarOutSelectors: string[] = [];

function getRightSidebarMode(pathname: string) {
	if (pathname.startsWith('/posts/') || pathname.startsWith('/notes/')) return 'toc';
	return 'none';
}

function getSidebarAnimationTargetsBySelectors(selectors: string[]) {
	const targets: HTMLElement[] = [];
	for (const selector of selectors) {
		const element = document.querySelector<HTMLElement>(selector);
		if (!element) continue;
		targets.push(element);
	}
	return targets;
}

function clearSidebarOutAnimations(selectors: string[] = activeSidebarOutSelectors) {
	sidebarOutAnimations.forEach((animation) => animation.cancel());
	sidebarOutAnimations = [];

	for (const element of getSidebarAnimationTargetsBySelectors(selectors)) {
		element.style.opacity = '';
		element.style.transform = '';
	}

	activeSidebarOutSelectors = [];
}

function playSidebarOutAnimations(selectors: string[]) {
	clearSidebarOutAnimations();
	activeSidebarOutSelectors = [...selectors];

	for (const element of getSidebarAnimationTargetsBySelectors(selectors)) {

		const animation = element.animate(
			[
				{ opacity: 1 },
				{ opacity: 0 },
			],
			{
				duration: SIDEBAR_OUT_ANIMATION_DURATION,
				easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
				fill: 'forwards',
			},
		);

		sidebarOutAnimations.push(animation);
	}
}

function playSidebarInAnimations(selectors: string[]) {
	for (const element of getSidebarAnimationTargetsBySelectors(selectors)) {
		element.style.opacity = '0';
		element.animate(
			[
				{ opacity: 0 },
				{ opacity: 1 },
			],
			{
				duration: SIDEBAR_IN_ANIMATION_DURATION,
				easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
				fill: 'forwards',
			},
		).onfinish = () => {
			element.style.opacity = '';
		};
	}
}

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	showBanner();
}

function getExpectedSidebarContentType(pathname: string) {
	if (pathname.startsWith('/notes/')) return 'notes';
	if (pathname.startsWith('/essays/')) return 'essays';
	if (pathname.startsWith('/posts/') || pathname.startsWith('/passage/')) return 'posts';
	return 'all';
}

function replaceSidebarWidgetIfChanged(
	currentSidebar: HTMLElement,
	incomingSidebar: Element,
	widgetId: string,
) {
	const selector = `widget-layout[data-id="${widgetId}"]`;
	const currentWidget = currentSidebar.querySelector(selector);
	const incomingWidget = incomingSidebar.querySelector(selector);

	if (!currentWidget && !incomingWidget) return;

	if (currentWidget && !incomingWidget) {
		currentWidget.remove();
		return;
	}

	if (!currentWidget && incomingWidget) {
		const sidebarSticky = currentSidebar.querySelector('#sidebar-sticky');
		if (sidebarSticky) {
			const widgetContainer =
				sidebarSticky.querySelector('#sidebar-widgets') || sidebarSticky;
			const incomingClone = incomingWidget.cloneNode(true);
			if (widgetId === 'categories') {
				const tagsWidget = widgetContainer.querySelector('widget-layout[data-id="tags"]');
				if (tagsWidget) {
					widgetContainer.insertBefore(incomingClone, tagsWidget);
				} else {
					widgetContainer.appendChild(incomingClone);
				}
			} else {
				widgetContainer.appendChild(incomingClone);
			}
		}
		return;
	}

	if (currentWidget && incomingWidget && currentWidget.outerHTML !== incomingWidget.outerHTML) {
		currentWidget.replaceWith(incomingWidget.cloneNode(true));
	}
}

function ensureSidebarWidgetOrder(sidebar: HTMLElement) {
	const sidebarSticky = sidebar.querySelector('#sidebar-sticky');
	if (!sidebarSticky) return;
	const widgetContainer =
		sidebarSticky.querySelector('#sidebar-widgets') || sidebarSticky;

	const categoriesWidget = widgetContainer.querySelector('widget-layout[data-id="categories"]');
	const tagsWidget = widgetContainer.querySelector('widget-layout[data-id="tags"]');
	if (!categoriesWidget || !tagsWidget) return;

	const categoriesAfterTags =
		(categoriesWidget.compareDocumentPosition(tagsWidget) & Node.DOCUMENT_POSITION_PRECEDING) !== 0;

	if (categoriesAfterTags) {
		widgetContainer.insertBefore(categoriesWidget, tagsWidget);
	}
}

async function syncSidebarIfNeeded() {
	const sidebar = document.getElementById('sidebar');
	if (!sidebar) return;

	const expected = getExpectedSidebarContentType(window.location.pathname);
	const current = sidebar.getAttribute('data-content-type') || 'posts';
	if (current === expected) return;

	try {
		const res = await fetch(window.location.href, {
			headers: { 'X-Requested-With': 'swup' },
		});
		if (!res.ok) return;
		const html = await res.text();
		const doc = new DOMParser().parseFromString(html, 'text/html');
		const incomingSidebar = doc.querySelector('#sidebar');
		if (incomingSidebar) {
			replaceSidebarWidgetIfChanged(sidebar, incomingSidebar, 'categories');
			replaceSidebarWidgetIfChanged(sidebar, incomingSidebar, 'tags');
			ensureSidebarWidgetOrder(sidebar);
			sidebar.setAttribute('data-content-type', expected);
		}
	} catch (_err) {
		return;
	}
}

/* Load settings when entering the site */
init();

const setup = () => {
	// Workaround for Firefox bug: clicking links with non-ASCII URLs
	// navigates to / instead of the target URL.
	// We intercept clicks on such links and navigate via JS instead.
	const needsWorkaround = /firefox/i.test(navigator.userAgent);
	if (needsWorkaround) {
		document.addEventListener('click', (e) => {
			const el = (e.target as Element)?.closest?.('a[href]');
			if (!el || el.tagName !== 'A') return;
			const a = el as HTMLAnchorElement;
			if (!a) return;
			// Don't interfere with modifier keys (new tab, new window)
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
			const rawHref = a.getAttribute('href') || '';
			// Only handle same-origin links with non-ASCII characters
			// (either raw unicode or percent-encoded like %E9%81%A5)
			const isNonAscii = /[^\x00-\x7F]/.test(rawHref)
				|| /%[89A-Fa-f][0-9A-Fa-f]/.test(rawHref);
			if (!rawHref.startsWith('/') || !isNonAscii) return;
			if (a.closest('[data-no-swup]')) return;
			const resolved = a.href;
			if (!resolved || resolved === window.location.href) return;
			try {
				const target = new URL(resolved);
				if (target.origin !== window.location.origin) return;
			} catch {
				return;
			}
			// Anchor hash navigation on same page
			const currentPath = window.location.pathname + window.location.search;
			const resolvedUrl = new URL(resolved);
			const targetPath = resolvedUrl.pathname + resolvedUrl.search;
			if (targetPath === currentPath) return;
			e.preventDefault();
			e.stopPropagation();
			window.location.assign(resolved);
		}, true);
	}

	// TODO: temp solution to change the height of the banner
