			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}, from?: {url: string}}) => {
		const toPathname = new URL(visit.to.url, window.location.origin).pathname;
		const fromPathname = visit.from?.url
			? new URL(visit.from.url, window.location.origin).pathname
			: window.location.pathname;

		const outSelectors: string[] = [];
		const inSelectors: string[] = [];

		const sidebar = document.getElementById('sidebar');
		const fromLeftType =
			sidebar?.getAttribute('data-content-type') ||
			getExpectedSidebarContentType(fromPathname);
		const toLeftType = getExpectedSidebarContentType(toPathname);
		if (fromLeftType !== toLeftType) {
			outSelectors.push('#sidebar-widgets');
			inSelectors.push('#sidebar-widgets');
		}

		const fromRightMode = document.getElementById('toc-wrapper') ? 'toc' : getRightSidebarMode(fromPathname);
		const toRightMode = getRightSidebarMode(toPathname);
		if (fromRightMode !== toRightMode) {
			if (fromRightMode === 'toc') outSelectors.push('#toc-wrapper');
			if (toRightMode === 'toc') inSelectors.push('#toc-wrapper');
		}

		hasSidebarNavigationTransition = outSelectors.length > 0 || inSelectors.length > 0;
		pendingSidebarInSelectors = inSelectors;
		if (hasSidebarNavigationTransition && outSelectors.length > 0) {
			playSidebarOutAnimations(outSelectors);
		}

		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		const mainPanel = document.getElementById('main-panel-wrapper')
		if (mainPanel) {
			if (bannerEnabled) {
				mainPanel.style.top = `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
			} else {
				mainPanel.style.top = '5.5rem'
			}
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('page:view', async () => {
		const shouldRunSidebarAnimation = hasSidebarNavigationTransition;
		if (shouldRunSidebarAnimation) {
			await syncSidebarIfNeeded();
			clearSidebarOutAnimations();
			if (pendingSidebarInSelectors.length > 0) {
				requestAnimationFrame(() => {
					playSidebarInAnimations(pendingSidebarInSelectors);
				});
			}
			hasSidebarNavigationTransition = false;
		}
		pendingSidebarInSelectors = [];

		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.add('hidden')
		}
		if (!shouldRunSidebarAnimation) {
			syncSidebarIfNeeded()
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let navbar = document.getElementById('navbar-wrapper')
let lastScrollTop = 0;
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (navbar) {
		const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
		const isScrollingDown = scrollTop > lastScrollTop;
		if (isScrollingDown && scrollTop > 72) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
		lastScrollTop = scrollTop;
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>

<script>
  import mermaid from 'mermaid';
  
  async function initMermaid() {
    const graphs = document.querySelectorAll('.mermaid');
    if (graphs.length > 0) {
      mermaid.initialize({ 
        startOnLoad: false, 
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default' 
      });
      // @ts-ignore
      await mermaid.run({ nodes: graphs });
    }
  }

  initMermaid();
  
  // Re-init on Swup navigation
  if (window.swup) {
      window.swup.hooks.on('page:view', initMermaid);
  } else {
      document.addEventListener('swup:enable', () => {
          window.swup.hooks.on('page:view', initMermaid);
      });
  }
</script>

<script is:inline>
  function switchTab(event) {
    const button = event.target;
    const container = button.closest('.tab-container');
    const index = button.getAttribute('data-tab-index');
    
    // Deactivate all
    container.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
    container.querySelectorAll('.tab-panel').forEach(p => {
        p.classList.remove('active');
        p.style.display = 'none';
    });
    
    // Activate target
    button.classList.add('active');
    const panel = container.querySelector(`.tab-panel[data-tab-index="${index}"]`);
    if (panel) {
        panel.classList.add('active');
        panel.style.display = 'block';
    }
  }
  // Expose to window for inline onclick handler
  window.switchTab = switchTab;
  
  // Re-attach if needed (though onclick attribute persists)
  // Swup might replace body, so window.switchTab persists.
</script>
