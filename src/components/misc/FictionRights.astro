---
import { profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateTimeToYYYYMMDDHHmm } from "../../utils/date-utils";
import {
	type FictionOrigin,
	fictionCopyrightNotice,
} from "../../utils/fiction-utils";

interface Props {
	title: string;
	pubDate: Date;
	origin: FictionOrigin;
	fandom: string;
	class?: string;
}

const { title, pubDate, origin, fandom } = Astro.props;
const className = Astro.props.class;
const postUrl = decodeURIComponent(Astro.url.toString());
const notice = fictionCopyrightNotice({ origin, fandom });
---
<div class={`relative transition overflow-hidden bg-[var(--license-block-bg)] py-5 px-6 ${className}`}>
    <div class="transition font-bold text-black/75 dark:text-white/75">
        {title}
    </div>
    <a href={postUrl} class="link text-[var(--primary)] break-all">
        {postUrl}
    </a>
    <div class="flex gap-6 mt-2">
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.author)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{profileConfig.name}</div>
        </div>
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.publishedAt)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{formatDateTimeToYYYYMMDDHHmm(pubDate)}</div>
        </div>
    </div>
    <p class="mt-3 text-sm text-black/60 dark:text-white/60 leading-relaxed">{notice}</p>
</div>
