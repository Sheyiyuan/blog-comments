---
import ToolGroup from './ToolGroup.astro';
import ToolCard from './ToolCard.astro';
import CollapsibleSection from './CollapsibleSection.astro';

import edgeIcon from '../../content/spec/images/icons/edge.svg';
import typstIcon from '../../content/spec/images/icons/typst.svg';
import latexIcon from '../../content/spec/images/icons/latex.svg';
import obsidianIcon from '../../content/spec/images/icons/obsidian.svg';
import docmostIcon from '../../content/spec/images/icons/docmost.ico';
import memosIcon from '../../content/spec/images/icons/memos.png';
import cherryStudioIcon from '../../content/spec/images/icons/cherry-studio.png';
import syncthingIcon from '../../content/spec/images/icons/syncthing.png';
import vscodeIcon from '../../content/spec/images/icons/vscode.svg';
import webstormIcon from '../../content/spec/images/icons/webstorm.svg';
import golandIcon from '../../content/spec/images/icons/goland.svg';
import pycharmIcon from '../../content/spec/images/icons/pycharm.svg';
import rstudioIcon from '../../content/spec/images/icons/rstudio.svg';
import zedIcon from '../../content/spec/images/icons/zed.png';
import neovimIcon from '../../content/spec/images/icons/neovim.ico';
import godotIcon from '../../content/spec/images/icons/godot.svg';
import typescriptIcon from '../../content/spec/images/icons/typescript.svg';
import javascriptIcon from '../../content/spec/images/icons/javascript.svg';
import goIcon from '../../content/spec/images/icons/go.svg';
import pythonIcon from '../../content/spec/images/icons/python.svg';
import rIcon from '../../content/spec/images/icons/r.png';
import dartIcon from '../../content/spec/images/icons/dart.svg';
import astroIcon from '../../content/spec/images/icons/astro.svg';
import astrbotIcon from '../../content/spec/images/icons/astrbot.png';
import reactIcon from '../../content/spec/images/icons/react.svg';
import electronIcon from '../../content/spec/images/icons/electron.svg';
import wailsIcon from '../../content/spec/images/icons/wails.ico';
import flutterIcon from '../../content/spec/images/icons/flutter.svg';
import fastapiIcon from '../../content/spec/images/icons/fastapi.png';
import ginIcon from '../../content/spec/images/icons/gin.svg';
import postgresqlIcon from '../../content/spec/images/icons/postgresql.svg';
import redisIcon from '../../content/spec/images/icons/redis.svg';
import dockerIcon from '../../content/spec/images/icons/docker.svg';
import caddyIcon from '../../content/spec/images/icons/caddy.svg';
import onepanelIcon from '../../content/spec/images/icons/onepanel.png';
import gitIcon from '../../content/spec/images/icons/git.svg';
import githubIcon from '../../content/spec/images/icons/github.svg';
import giteaIcon from '../../content/spec/images/icons/gitea.svg';
import githubActionsIcon from '../../content/spec/images/icons/github-actions.svg';
import kittyIcon from '../../content/spec/images/icons/kitty.svg';
import sealdiceIcon from '../../content/spec/images/icons/sealdice.png';
import maibotIcon from '../../content/spec/images/icons/maibot.png';
import tuanchatIcon from '../../content/spec/images/icons/tuanchat.png';
import archlinuxIcon from '../../content/spec/images/icons/archlinux.svg';
import debianIcon from '../../content/spec/images/icons/debian.svg';
import rockyLinuxIcon from '../../content/spec/images/icons/rocky-linux.svg';
import macosIcon from '../../content/spec/images/icons/macos.svg';
---

<CollapsibleSection summary="点击查看牢社严选">
  <div style="display: flex; flex-direction: column; gap: 24px; margin-top: 20px; text-align: left;">

    <ToolGroup title="操作系统 (Environment)">
      <ToolCard name="Arch Linux" desc="ThinkPad X1 Carbon" icon={archlinuxIcon} url="https://archlinux.org/" />
      <ToolCard name="Debian" desc="ASUS FX507VV" icon={debianIcon} url="https://www.debian.org/" />
      <ToolCard name="Rocky Linux" desc="Server" icon={rockyLinuxIcon} url="https://rockylinux.org/" />
      <ToolCard name="macOS" desc="MacBook Air M2 2022" icon={macosIcon} url="https://www.apple.com/macos/" iconStyle="margin: 0; background: white; border-radius: 50%; padding: 2px;" />
    </ToolGroup>

    <ToolGroup title="效率 (Productivity)">
      <ToolCard name="Edge" desc="浏览器" icon={edgeIcon} url="https://www.microsoft.com/edge" />
      <ToolCard name="Kitty" desc="终端模拟器" icon={kittyIcon} url="https://sw.kovidgoyal.net/kitty/" />
      <ToolCard name="Typst" desc="排版工具" icon={typstIcon} url="https://typst.app/" />
      <ToolCard name="LaTeX" desc="排版工具" icon={latexIcon} url="https://www.latex-project.org/" />
      <ToolCard name="Obsidian" desc="笔记" icon={obsidianIcon} url="https://obsidian.md/" />
      <ToolCard name="Docmost" desc="笔记" icon={docmostIcon} url="https://docmost.com/" />
      <ToolCard name="Memos" desc="笔记" icon={memosIcon} url="https://usememos.com/" />
      <ToolCard name="Cherry Studio" desc="AI" icon={cherryStudioIcon} url="https://www.cherry-ai.com/" />
      <ToolCard name="Syncthing" desc="文件同步" icon={syncthingIcon} url="https://syncthing.net/" />
    </ToolGroup>

    <ToolGroup title="Bot / TRPG (Bots & TRPG)">
      <ToolCard name="AstrBot" desc="AI 助手 / Agent 平台" icon={astrbotIcon} url="https://astrbot.app/" />
      <ToolCard name="SealDice" desc="TRPG 骰娘框架" icon={sealdiceIcon} url="https://dice.weizaima.com/" />
      <ToolCard name="MaiBot" desc="QQ Bot / 麦麦" icon={maibotIcon} url="https://docs.mai-mai.org/" />
      <ToolCard name="团剧共创 tuanchat" desc="跑团平台" icon={tuanchatIcon} url="https://tuan.chat" />
    </ToolGroup>

    <ToolGroup title="开发 (Development)">
      <ToolCard name="VS Code" desc="IDE" icon={vscodeIcon} url="https://code.visualstudio.com/" />
      <ToolCard name="WebStorm" desc="IDE" icon={webstormIcon} url="https://www.jetbrains.com/webstorm/" />
      <ToolCard name="GoLand" desc="IDE" icon={golandIcon} url="https://www.jetbrains.com/go/" />
      <ToolCard name="PyCharm" desc="IDE" icon={pycharmIcon} url="https://www.jetbrains.com/pycharm/" />
      <ToolCard name="RStudio" desc="IDE" icon={rstudioIcon} url="https://posit.co/products/open-source/rstudio/" />
      <ToolCard name="Zed" desc="IDE" icon={zedIcon} url="https://zed.dev/" />
      <ToolCard name="Neovim" desc="IDE" icon={neovimIcon} url="https://neovim.io/" />
      <ToolCard name="Godot" desc="游戏引擎" icon={godotIcon} url="https://godotengine.org/" />
    </ToolGroup>

    <ToolGroup title="语言 (Languages)">
      <ToolCard name="TypeScript" desc="全栈开发" icon={typescriptIcon} url="https://www.typescriptlang.org/" />
      <ToolCard name="JavaScript" desc="全栈开发" icon={javascriptIcon} url="https://developer.mozilla.org/en-US/docs/Web/JavaScript" />
      <ToolCard name="Go" desc="后端开发" icon={goIcon} url="https://go.dev/" />
      <ToolCard name="Python" desc="后端开发 / 数据科学" icon={pythonIcon} url="https://www.python.org/" />
      <ToolCard name="R" desc="统计分析" icon={rIcon} url="https://www.r-project.org/" />
      <ToolCard name="Dart" desc="客户端开发" icon={dartIcon} url="https://dart.dev/" />
    </ToolGroup>

    <ToolGroup title="技术栈 (Technologies)">
      <ToolCard name="Astro" desc="框架" icon={astroIcon} url="https://astro.build/" />
      <ToolCard name="React" desc="框架" icon={reactIcon} url="https://astro.build/" />
      <ToolCard name="Electron" desc="框架" icon={electronIcon} url="https://www.electronjs.org/" />
      <ToolCard name="Wails" desc="框架" icon={wailsIcon} url="https://wails.io/" />
      <ToolCard name="Flutter" desc="框架" icon={flutterIcon} url="https://flutter.dev/" />
      <ToolCard name="FastAPI" desc="框架" icon={fastapiIcon} url="https://fastapi.tiangolo.com/" />
      <ToolCard name="Gin" desc="框架" icon={ginIcon} url="https://gin-gonic.com/" />
      <ToolCard name="PostgreSQL" desc="数据库" icon={postgresqlIcon} url="https://www.postgresql.org/" />
      <ToolCard name="Redis" desc="数据库" icon={redisIcon} url="https://redis.io/" />
    </ToolGroup>

    <ToolGroup title="运维 (DevOps & Tools)">
      <ToolCard name="Docker" desc="DevOps" icon={dockerIcon} url="https://www.docker.com/" />
      <ToolCard name="Caddy" desc="Web Server" icon={caddyIcon} url="https://caddyserver.com/" />
      <ToolCard name="1Panel" desc="Server Panel" icon={onepanelIcon} url="https://1panel.cn/" />
      <ToolCard name="Git" desc="VCS" icon={gitIcon} url="https://git-scm.com/" />
      <ToolCard name="GitHub" desc="代码托管" icon={githubIcon} url="https://github.com/" />
      <ToolCard name="Gitea" desc="代码托管" icon={giteaIcon} url="https://about.gitea.com/" />
      <ToolCard name="GitHub Actions" desc="CI/CD" icon={githubActionsIcon} url="https://github.com/features/actions" />
    </ToolGroup>

  </div>
</CollapsibleSection>