---
interface Props {
  name: string;
  desc: string;
  icon: string | ImageMetadata;
  url: string;
  iconStyle?: string;
}
const { name, desc, icon, url, iconStyle = "margin: 0;" } = Astro.props;

// Handle imported image metadata via MDX vs pure string references
const src = typeof icon === 'string' ? icon : icon.src;
---
<a href={url} target="_blank" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit;">
  <img src={src} width="32" height="32" style={iconStyle} alt={name} class="m-0" />
  <div style="display: flex; flex-direction: column; gap: 4px;">
    <span style="font-weight: 600; font-size: 14px; line-height: 1;">{name}</span>
    <span style="font-size: 12px; opacity: 0.6; line-height: 1;">{desc}</span>
  </div>
</a>