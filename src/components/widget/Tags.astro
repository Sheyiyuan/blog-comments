---

import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";
import ButtonTag from "../control/ButtonTag.astro";
import WidgetLayout from "./WidgetLayout.astro";

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
	class?: string;
	style?: string;
	contentType?: "posts" | "notes" | "essays" | "all";
}
const className = Astro.props.class;
const style = Astro.props.style;
const contentType = Astro.props.contentType ?? "posts";

const tags = await getTagList(contentType);
const isCollapsed = tags.length >= 20;
const listBasePath =
	contentType === "notes"
		? "/notes/"
		: contentType === "essays"
			? "/essays/"
			: "/archive/";
---
<WidgetLayout name={i18n(I18nKey.tags)} id="tags" isCollapsed={isCollapsed} canCollapse={true} collapsedHeight={COLLAPSED_HEIGHT} class={className} style={style}>
    <div class="flex gap-2 flex-wrap">
        {tags.map(t => (
            <ButtonTag href={getTagUrl(t.name, listBasePath)} label={`View all posts with the ${t.name.trim()} tag`}>
                {t.name.trim()}
            </ButtonTag>
        ))}
    </div>
</WidgetLayout>