---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	contentType?: "posts" | "notes" | "essays" | "all";
}

const className = Astro.props.class;
const contentType = Astro.props.contentType ?? "posts";
---
<div id="sidebar" data-content-type={contentType} class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div
        id="sidebar-sticky"
        class="transition-[top] duration-300 flex flex-col w-full gap-4 sticky top-[5.5rem]"
    >
        <div id="sidebar-widgets" class="flex flex-col w-full gap-4">
            {contentType !== "essays" && <Categories contentType={contentType}></Categories>}
            <Tag contentType={contentType}></Tag>
        </div>
    </div>
</div>
